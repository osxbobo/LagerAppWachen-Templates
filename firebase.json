{
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "YOUR_PROJECT_ID",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "tools/**",
      "node_modules/**",
      "serve.py",
      "README.md",
      "*.png",
      "*.PNG",
      "mockup.html",
      "cors.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
